{
  "name": "sentinel-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SENTINEL \u2014 an autonomous supply-chain CVE strike team on the TrueForge agent harness. Web console, live OSV triage, approval-gated pull requests and the WebMCP OMNI-LAB.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:mcp": "node scripts/mcp-conformance.mjs",
    "check:webmcp": "node scripts/webmcp-conformance.mjs",
    "verify": "npm run typecheck && npm run check:webmcp && npm run build && npm run check:mcp",
    "lint": "next lint"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.0"
  }
}
